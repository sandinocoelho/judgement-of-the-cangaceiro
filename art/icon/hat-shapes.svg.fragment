<!-- Grupo compartilhado do chapéu de meia-lua (Conceito A, CANGA-16).
     Coordenadas pensadas para canvas 1024x1024 com o conteúdo dentro da
     zona segura de 66% (~676px centrais) exigida pelo adaptive foreground.
     Este fragmento é injetado nas variantes pelo generate-icons.sh — edite
     AQUI, nunca nos SVGs gerados. -->
<g id="hat">
  <!-- aba de meia-lua (leque traseiro) -->
  <path d="M 212 570 A 300 300 0 0 1 812 570 Q 512 500 212 570 Z"
        fill="#6B4423" stroke="#2B1A10" stroke-width="14" stroke-linejoin="round"/>
  <!-- friso claro acompanhando a borda externa da meia-lua -->
  <path d="M 246 552 A 266 266 0 0 1 778 552" fill="none"
        stroke="#9C6B2F" stroke-width="16" stroke-linecap="round"/>
  <!-- tachas de metal ao longo da borda -->
  <g fill="#E8B44A" stroke="#2B1A10" stroke-width="6">
    <circle cx="278" cy="452" r="13"/>
    <circle cx="352" cy="382" r="13"/>
    <circle cx="443" cy="341" r="13"/>
    <circle cx="581" cy="341" r="13"/>
    <circle cx="672" cy="382" r="13"/>
    <circle cx="746" cy="452" r="13"/>
  </g>
  <!-- copa (domo) -->
  <path d="M 330 640 Q 330 440 512 440 Q 694 440 694 640 Q 512 700 330 640 Z"
        fill="#7A4E22" stroke="#2B1A10" stroke-width="14" stroke-linejoin="round"/>
  <!-- cinta de couro da copa -->
  <path d="M 334 610 Q 512 668 690 610 L 690 648 Q 512 706 334 648 Z"
        fill="#4E3115" stroke="#2B1A10" stroke-width="10" stroke-linejoin="round"/>
  <!-- aba frontal dobrada para cima -->
  <path d="M 262 678 Q 512 600 762 678 Q 512 760 262 678 Z"
        fill="#8A5A2E" stroke="#2B1A10" stroke-width="14" stroke-linejoin="round"/>
  <!-- estrela de seis pontas no centro da meia-lua -->
  <g transform="translate(512 360)">
    <path d="M 0 -74 L 21 -37 L 64 -37 L 43 0 L 64 37 L 21 37 L 0 74 L -21 37 L -64 37 L -43 0 L -64 -37 L -21 -37 Z"
          fill="#F4C95D" stroke="#2B1A10" stroke-width="10" stroke-linejoin="round"/>
  </g>
</g>
